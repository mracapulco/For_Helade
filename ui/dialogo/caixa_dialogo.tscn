[node name="CaixaDialogo" type="CanvasLayer"]
layer = 100
script = ExtResource("1_caixa")

[node name="Balloon" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
