; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Por Hélade"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Relacoes="*res://scripts/autoload/relacoes.gd"
Influencia="*res://scripts/autoload/influencia.gd"
Elenco="*res://scripts/autoload/elenco.gd"
Configuracoes="*res://scripts/autoload/configuracoes.gd"
Progresso="*res://scripts/autoload/progresso.gd"
TrocaCena="*res://scripts/autoload/troca_cena.gd"
Inventario="*res://scripts/autoload/inventario.gd"
Experiencia="*res://scripts/autoload/experiencia.gd"
Mundo="*res://scripts/autoload/mundo.gd"
Trilha="*res://scripts/autoload/trilha.gd"
Pausa="*res://scripts/autoload/pausa.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/caixa_dialogo.tscn"
editor/translations/use_static_ids_as_translation_keys=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://assets/ui/tema_helade.tres"

