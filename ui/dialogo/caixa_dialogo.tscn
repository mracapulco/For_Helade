theme_override_constants/margin_bottom = 24

[node name="Painel" type="PanelContainer" parent="Balloon/Margem"]
layout_mode = 2
mouse_filter = 1

[node name="Linha" type="HBoxContainer" parent="Balloon/Margem/Painel"]
layout_mode = 2
