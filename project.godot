[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.pt_BR.translation")
locale/translations_pot_files=PackedStringArray("res://data/dialogos/teste/teste.dialogue", "res://data/dialogos/teste/exploracao.dialogue", "res://data/dialogos/prologo/prologo.dialogue", "res://data/dialogos/acampamentos/acampamento.dialogue")
locale/fallback="pt_BR"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
